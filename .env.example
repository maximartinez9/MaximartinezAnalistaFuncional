# Copiá este archivo como .env (NUNCA lo subas a GitHub)
DATABASE_URL=postgresql://usuario:clave@host/basededatos?sslmode=require
# Generá cada valor con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ENC_KEY=
# Administrador inicial (se crea al arrancar)
ADMIN_EMAIL=tu-correo@ejemplo.com
ADMIN_PASSWORD=una-clave-larga-de-10-o-mas-caracteres
# false = cierra el registro público
ALLOW_REGISTER=true
